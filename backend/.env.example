# =============================================================================
# AI Sales Agent Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# =============================================================================

# --- App ---
ENVIRONMENT=development
SECRET_KEY=your-secret-key-min-32-chars
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadgen

# --- Business (agent persona & catalog currency) ---
COMPANY_NAME=Acme Cloud
AGENT_NAME=Ava
DEFAULT_CURRENCY=USD

# --- LLM Provider ---
# "groq" (hosted) or "ollama" (local qwen3:8b)
LLM_PROVIDER=groq
OLLAMA_MODEL=qwen3:8b

# --- Groq (used when LLM_PROVIDER=groq) ---
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- WhatsApp Business API (Meta Cloud API) ---
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v23.0

# --- Google Calendar ---
GOOGLE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC

# --- Email (SMTP) ---
# Use Brevo (free 300/day), Gmail App Password, or any SMTP provider.
# Leave empty for dev mode (emails logged to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com

# --- Admin ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_WHATSAPP_NUMBER=1XXXXXXXXXX
